{
  "name": "@declarative-hex-worlds/docs",
  "private": true,
  "version": "0.0.0",
  "description": "Sourcey documentation site for declarative-hex-worlds.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "api:generate": "typedoc --options typedoc.json",
    "dev": "pnpm api:generate && sourcey dev",
    "build": "pnpm api:generate && sourcey build",
    "validate": "pnpm api:generate && sourcey build --output .sourcey-validate"
  },
  "devDependencies": {
    "sourcey": "3.6.5",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.12.0"
  }
}
